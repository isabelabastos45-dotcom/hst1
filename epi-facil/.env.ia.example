# Copie este arquivo para .env na raiz do projeto e preencha sua chave.
# NUNCA envie o arquivo .env ao GitHub.
GEMINI_API_KEY=cole_sua_chave_aqui
GEMINI_MODEL=gemini-3.8-flash
PORT=3001

# Para outras portas/origens, configure separadas por vírgula:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Para frontend hospedado em outro domínio, configure VITE_API_URL no ambiente do frontend.
